# --version prints the version to stdout, and wins over a command, so a
# version query never starts the server.
sprut --version
stdout '^sprut version \S+\n$'
! stderr .

sprut --version serve
stdout '^sprut version \S+\n$'
! stderr .

# Help goes to stdout and exits 0, and writes glossary terms lowercase, like
# any other message.
env GLOSSARY='\b(Gateway|Upstreams?|Transports?|Agents?|Config|Namespaced|Logins?|Credentials)\b'

sprut -h
stdout 'serve'
stdout '--version'
! stdout $GLOSSARY
! stderr .

sprut --help
stdout 'serve'
! stderr .

sprut serve -h
stdout '--config'
stdout '--startup-timeout'
stdout '--verbose'
stdout '--dry-run'
! stdout $GLOSSARY
! stderr .

sprut serve --help
stdout '--dry-run'
! stderr .

sprut upstream -h
! stdout $GLOSSARY
sprut upstream add -h
! stdout $GLOSSARY
sprut upstream remove -h
! stdout $GLOSSARY
sprut upstream enable -h
! stdout $GLOSSARY
sprut upstream disable -h
! stdout $GLOSSARY
sprut upstream list -h
! stdout $GLOSSARY
sprut upstream login -h
! stdout $GLOSSARY
sprut upstream logout -h
! stdout $GLOSSARY
