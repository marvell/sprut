{
  "mcpServers": {
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything", "stdio"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "hello": {
      "command": "go",
      "args": ["run", "github.com/modelcontextprotocol/go-sdk/examples/server/hello@v1.8.0"]
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
